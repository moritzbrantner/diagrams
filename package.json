{
  "name": "@moritzbrantner/diagrams",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moritzbrantner/diagrams.git"
  },
  "homepage": "https://moritzbrantner.github.io/diagrams/",
  "bugs": {
    "url": "https://github.com/moritzbrantner/diagrams/issues"
  },
  "license": "MIT",
  "packageManager": "bun@1.3.14",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./charts": {
      "types": "./dist/charts.d.ts",
      "import": "./dist/charts.js"
    },
    "./org-chart": {
      "types": "./dist/org-chart.d.ts",
      "import": "./dist/org-chart.js"
    },
    "./process-map": {
      "types": "./dist/process-map.d.ts",
      "import": "./dist/process-map.js"
    },
    "./relationship-map": {
      "types": "./dist/relationship-map.d.ts",
      "import": "./dist/relationship-map.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.7.0",
    "tailwind-merge": "^3.4.0"
  },
  "peerDependencies": {
    "@moritzbrantner/ui": "^0.9.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^9",
    "@moritzbrantner/ui": "^0.9.1",
    "@playwright/test": "^1.60.0",
    "@storybook/addon-a11y": "^10.4.1",
    "@storybook/addon-vitest": "^10.4.1",
    "@storybook/builder-vite": "^10.4.1",
    "@storybook/react-vite": "^10.4.1",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitest/browser": "^4.1.7",
    "@vitest/browser-playwright": "^4.1.7",
    "@vitest/coverage-istanbul": "^4.1.7",
    "eslint": "^9",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.8.3",
    "publint": "^0.3.21",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.8.1",
    "storybook": "^10.4.1",
    "tailwindcss": "^4.3.0",
    "tsup": "^8.5.0",
    "typedoc": "^0.28.19",
    "typescript": "6.0.2",
    "typescript-eslint": "^8.60.0",
    "unlighthouse": "^0.17.9",
    "vite": "^8.0.14",
    "vitest": "^4.1.2"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts src/charts.ts src/org-chart.ts src/process-map.ts src/relationship-map.ts --format esm --dts --clean --out-dir dist",
    "build:examples": "vite build --outDir ../dist-examples --emptyOutDir",
    "build:storybook": "storybook build --output-dir storybook-static",
    "changeset": "changeset",
    "check-types": "tsc --noEmit",
    "dev": "vite",
    "docs": "typedoc",
    "docs:check": "typedoc --emit none",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "pack:check": "bun run build && publint --pack bun --strict && node ./scripts/check-packed-artifact.mjs",
    "prepack": "bun run build",
    "release": "changeset publish",
    "storybook": "storybook dev -p 6006",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:storybook": "playwright test -c playwright.storybook.config.ts",
    "test:visual": "playwright test -c playwright.visual.config.ts",
    "verify": "bun run check-types && bun run lint && bun run format:check && bun run docs:check && bun run test:coverage && bun run build:examples && bun run pack:check && bun run test:e2e && bun run build:storybook && bun run test:storybook && bun run test:visual"
  }
}
