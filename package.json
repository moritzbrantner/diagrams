{
  "name": "@moritzbrantner/diagrams",
  "version": "0.1.0",
  "private": false,
  "homepage": "https://moritzbrantner.github.io/diagrams/",
  "bugs": {
    "url": "https://github.com/moritzbrantner/diagrams/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moritzbrantner/diagrams.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./architecture-diagram": {
      "types": "./dist/architecture-diagram.d.ts",
      "import": "./dist/architecture-diagram.js"
    },
    "./decision-tree": {
      "types": "./dist/decision-tree.d.ts",
      "import": "./dist/decision-tree.js"
    },
    "./dependency-graph": {
      "types": "./dist/dependency-graph.d.ts",
      "import": "./dist/dependency-graph.js"
    },
    "./entity-relationship-diagram": {
      "types": "./dist/entity-relationship-diagram.d.ts",
      "import": "./dist/entity-relationship-diagram.js"
    },
    "./gantt-chart": {
      "types": "./dist/gantt-chart.d.ts",
      "import": "./dist/gantt-chart.js"
    },
    "./journey-map": {
      "types": "./dist/journey-map.d.ts",
      "import": "./dist/journey-map.js"
    },
    "./mind-map": {
      "types": "./dist/mind-map.d.ts",
      "import": "./dist/mind-map.js"
    },
    "./org-chart": {
      "types": "./dist/org-chart.d.ts",
      "import": "./dist/org-chart.js"
    },
    "./process-map": {
      "types": "./dist/process-map.d.ts",
      "import": "./dist/process-map.js"
    },
    "./relationship-map": {
      "types": "./dist/relationship-map.d.ts",
      "import": "./dist/relationship-map.js"
    },
    "./sequence-diagram": {
      "types": "./dist/sequence-diagram.d.ts",
      "import": "./dist/sequence-diagram.js"
    },
    "./state-machine-diagram": {
      "types": "./dist/state-machine-diagram.d.ts",
      "import": "./dist/state-machine-diagram.js"
    },
    "./swimlane-diagram": {
      "types": "./dist/swimlane-diagram.d.ts",
      "import": "./dist/swimlane-diagram.js"
    },
    "./timeline-diagram": {
      "types": "./dist/timeline-diagram.d.ts",
      "import": "./dist/timeline-diagram.js"
    },
    "./uml-diagram": {
      "types": "./dist/uml-diagram.d.ts",
      "import": "./dist/uml-diagram.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "api:check": "bun run build && node ./scripts/check-api-report.mjs",
    "audit:production": "bun audit --production",
    "bench:diagrams": "bun run build && node ./scripts/benchmark-diagrams.mjs",
    "build": "tsup src/index.ts src/architecture-diagram.ts src/decision-tree.ts src/dependency-graph.ts src/entity-relationship-diagram.ts src/gantt-chart.ts src/journey-map.ts src/mind-map.ts src/org-chart.ts src/process-map.ts src/relationship-map.ts src/sequence-diagram.ts src/state-machine-diagram.ts src/swimlane-diagram.ts src/timeline-diagram.ts src/uml-diagram.ts --format esm --dts --clean --out-dir dist",
    "build:examples": "vite build --outDir ../dist-examples --emptyOutDir && bun run docs && node ./scripts/copy-docs-to-examples.mjs",
    "build:storybook": "storybook build --output-dir storybook-static",
    "changeset": "changeset",
    "check-types": "tsc --noEmit",
    "dev": "vite",
    "docs": "typedoc",
    "docs:check": "typedoc --emit none",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "eslint . --max-warnings 0",
    "pack:check": "bun run build && publint --pack bun --strict && node ./scripts/check-packed-artifact.mjs",
    "prepack": "bun run build",
    "quality:pages": "bun run test:unlighthouse",
    "release": "changeset publish",
    "storybook": "storybook dev -p 6006",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:storybook": "playwright test -c playwright.storybook.config.ts",
    "test:unlighthouse": "node ./scripts/run-unlighthouse.mjs",
    "test:visual": "playwright test -c playwright.visual.config.ts",
    "verify": "bun run check-types && bun run lint && bun run format:check && bun run docs:check && bun run test:coverage && bun run api:check && bun run build:examples && bun run pack:check && bun run test:e2e && bun run build:storybook && bun run test:storybook && bun run test:visual && bun run test:unlighthouse",
    "verify:release": "bun run verify && bun run bench:diagrams",
    "version-packages": "changeset version"
  },
  "dependencies": {
    "@tanstack/react-query": "5.101.0",
    "lucide-react": "^1.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^9",
    "@moritzbrantner/ui": "^0.9.1",
    "@playwright/test": "^1.60.0",
    "@storybook/addon-a11y": "^10.4.1",
    "@storybook/addon-vitest": "^10.4.1",
    "@storybook/builder-vite": "^10.4.1",
    "@storybook/react-vite": "^10.4.1",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitest/browser": "^4.1.7",
    "@vitest/browser-playwright": "^4.1.7",
    "@vitest/coverage-istanbul": "^4.1.7",
    "eslint": "^9",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "jsdom": "^26.1.0",
    "oxfmt": "0.53.0",
    "publint": "^0.3.21",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "storybook": "^10.4.1",
    "tailwindcss": "^4.3.0",
    "tsup": "^8.5.0",
    "typedoc": "^0.28.19",
    "typescript": "6.0.2",
    "typescript-eslint": "^8.60.0",
    "unlighthouse": "^0.17.9",
    "vite": "^8.0.14",
    "vitest": "^4.1.2"
  },
  "peerDependencies": {
    "@moritzbrantner/ui": "^0.9.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "packageManager": "bun@1.3.14"
}
